# The vector index is derived from findings.json + ARCHITECTURE.md and is rebuilt by
# ingest.py in seconds. Committing it would put a binary that changes on every run next
# to the text that is the actual record.
.chroma/
.chroma-*/

# checkpoint.py writes a .bak beside every file it is about to edit. Those are session
# safety copies, not versions - git already holds the history they duplicate.
*.bak
