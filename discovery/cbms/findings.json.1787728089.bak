  "structure": {
    "chunk_record": {
      "always": ["id", "concept", "content", "created", "size", "references", "access_count", "last_accessed"],
      "optional_measured_2026_08_26": {
        "hangul_code": 52,
        "pattern_type": 32,
        "source": 21,
        "success_rate": 16,
        "domain": 16,
        "usage_count": 16,
        "eo": 13,
        "cbms_codes": 13,
        "strategy_id": 8,
        "metaphor_id": 8,
        "state_id": 8,
        "template_id": 8,
        "url": 8
      },
      "reading": "The optional fields are strata. Each group of 8 or 16 is one writer that ran once and left its own shape behind."
    },
    "stores": {
      "chunks": "live knowledge, 167",
      "chunks_quarantine": "the 455 echo blocks, removed but kept",
      "chunks_purgatory": "3, holding pen with its own ledger (purgatory_ledger.json)",
      "blends": "8, the real learning channel: mistake -> analyzer -> conclusion",
      "gate_rejections.jsonl": "59 lines, what the write gate refused and why",
      "facts_index.json": "separate fact index",
      "operator_profile.json": "operator profile",
      "thinking_log.jsonl": "thinking session log"
    },
    "environment_switches": {
      "AIONS_WRITE_GATE": "0 disables the write gate (default on)",
      "AIONS_RETRIEVAL_LIMIT": "total retrieval cap, default 40; 0 restores pre-2026-08-04 behaviour",
      "AIONS_RETRIEVAL_KR_LIMIT": "Korean-key hits, default 25",
      "AIONS_RETRIEVAL_CONCEPT_LIMIT": "per concept bucket, default 8",
      "AIONS_GRAPH_EXPAND": "1 enables reference-graph expansion (default off)",
      "AIONS_GRAPH_MIN_SUPPORT": "co-citation votes required, default 2",
      "AIONS_GRAPH_MAX_DEGREE": "skip hubs above this out-degree, default 40",
      "CBMS_SYMBOLIC": "1 enables the Esperanto/code-book index (default on)",
      "CBMS_MEMORY_DIR": "location of the memory directory"
    }
  },

  "open_questions": [
    "Which 8 chunk files have no manifest entry, and which writer created them? (F14)",
    "Open the CBMS_KR variants and check whether they are a real engine family or another self-report. (F15)",
    "The code book has 16 symbols and encodes one demo sentence plus telemetry. Is growing it the right move, or is the Korean-key layer the one that should carry retrieval permanently? Nothing measured yet compares the two on the same queries.",
    "chunks_quarantine holds 455 blocks. Is any of it recoverable, or is quarantine effectively deletion with a longer name?"
  ]
}
