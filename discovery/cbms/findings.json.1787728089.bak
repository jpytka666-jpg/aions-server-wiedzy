    {
      "id": "F09",
      "claim": "The reference graph exists, was never read for years, and is still switched off because it is poisoned rather than broken.",
      "status": "CONFIRMED",
      "evidence": {
        "graph_size_recorded_in_code": "~49 000 edges; 90.65% of 49 374 edges lead to the echo blocks",
        "never_read": "audit 2026-08-04: no retrieval code walked 'references'; the graph was written and never read",
        "reader_added": "expand_with_references(seed_ids, min_support=2, max_expand=10, max_out_degree=40, max_seeds=20)",
        "default": "OFF - AIONS_GRAPH_EXPAND=1 to enable",
        "why_off": "Technically correct (reversible 10/10, zero regression on the first 15 results, ~5 ms overhead) but it surfaces mostly garbage. The synthesis blocks cite each other, forming a self-referential cluster with LOW out-degree, so max_out_degree misses it, and HIGH co-citation, so raising min_support does not help either (min_support=3 tested, cluster survives).",
        "recorded_order_of_work": "first the write gate to stop producing garbage, then cleaning, only then switch the graph on"
      }
    },
