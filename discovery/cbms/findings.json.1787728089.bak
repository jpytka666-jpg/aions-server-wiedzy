      "id": "F18",
      "claim": "There are two unrelated chunk-id schemes in CBMS, and confusing them explains part of the muddle.",
      "status": "CONFIRMED",
      "evidence": {
        "scheme_S": {"format": "'S' + SHA-256(content)[:16] uppercased", "file": "cbms_chunker.py create_chunk_id()", "purpose": "splitting a large text into pieces that fit an API limit; carries start_pos, end_pos, chunk_num"},
        "scheme_K": {"format": "'K' + SHA-256(content)[:12] uppercased", "file": "cbms_memory.py create_knowledge_chunk()", "purpose": "a unit of knowledge in the store; carries concept, references, access counters"},
        "scheme_KR": {"format": "KR_<DOMAIN>_<KRCODE>_<HASH6>", "file": "kr_cbms_generator.py", "purpose": "a knowledge unit whose id states its subject"},
        "why_it_matters": "S-chunks are a transport detail, K-chunks are memory. They look alike, are produced by different files, and neither can be turned into the other. A search for 'CBMS chunks' returns both."
      }
