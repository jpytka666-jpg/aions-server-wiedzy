  "name": {
    "expansion": "Code Book Memory System",
    "confirmed_by": "aions_core/server/codebook_engine.py docstring: 'CBMS Codebook engine: load a small codebook and map EO text <-> CBMS codes.'",
    "note": "The name describes the intended mechanism - a code book - not the mechanism that carries most of the retrieval traffic today."
  },

  "findings": [
    {
      "id": "F01",
      "claim": "CBMS stores knowledge as content-addressed chunks: id = 'K' + first 12 hex of SHA-256(content), uppercased.",
      "status": "CONFIRMED",
      "evidence": {
        "file": "aions_core/server/cbms_memory.py",
        "line": 195,
        "code": "chunk_id = \"K\" + hashlib.sha256(content.encode('utf-8')).hexdigest()[:12].upper()",
        "consequence": "Identical content overwrites the same file. Deduplication is a property of the address, not of a check."
      }
    },
    {
      "id": "F02",
      "claim": "The intended pipeline is PL/EN -> Esperanto -> codebook symbols -> symbol index.",
      "status": "CONFIRMED",
      "evidence": {
        "stages": [
          {"module": "aions_core/server/esperanto_bridge.py", "lines": 99, "entry": "to_esperanto(s, lang='pl')", "role": "deterministic canonicalisation; a 30-entry dictionary plus regex, explicitly 'not a translator'"},
          {"module": "aions_core/server/codebook_engine.py", "lines": 56, "entry": "Codebook.encode_eo_to_cbms(eo_text)", "role": "greedy longest-phrase-first match, spans marked used so nothing double-matches"},
          {"module": "aions_core/server/cbms_symbolic_index.py", "lines": 56, "entry": "SymbolicIndex.build() / .search()", "role": "symbol -> chunk set, built on the fly, explicitly non-destructive"}
        ],
        "why_esperanto": "One concept, one form. Polish inflection ('bylem'/'bylam') collapses to a single Esperanto phrase ('mi estis') before any symbol is assigned, so the codebook needs one entry instead of many."
      }
    },
    {
      "id": "F03",
      "claim": "The code book is tiny: 16 symbols.",
      "status": "CONFIRMED",
      "evidence": {
        "file": "aions_core/memory/codebook/codebook.json",
        "symbol_count": 16,
        "families": {
          "A1-E5": "a five-symbol demonstration sentence (byc-past-1sg, dzisiaj, miejsce-sklep, kupic-1sg-past, chleb)",
          "CR1-CR5": "CRLA tournament vocabulary (system, winner, score, latency, determinism)",
          "CB1-CB6": "CBMS self-description (system, memory-block, chunk, refusal, panic, facts-keys)"
        },
        "record_shape": "{code: {sem, eo: [phrases], pl: [phrases]}}",
        "consequence": "A 16-symbol book cannot encode general knowledge. It encodes exactly two things: a demo sentence and the system's own telemetry vocabulary."
      }
    },
    {
      "id": "F04",
      "claim": "Only 13 of 167 live chunks have their content reduced to code-book symbols, and all 13 are CRLA telemetry from one day.",
      "status": "CONFIRMED",
      "evidence": {
        "measured_by": "discovery/inventory.py, 2026-08-26",
        "chunks_with_cbms_codes": 13,
        "concept": "crla_pattern (all 13)",
        "codes_used": ["CR1", "CR2", "CR3", "CR4"],
        "created": "2025-10-28, between 12:53 and 19:00",
        "example": {
          "id": "K6A832F435D0C",
          "pl": "CRLA turniej: zwyciezca C04, wynik 0.956, latencja 0.719 ms.",
          "eo": "crla turniro: gajninto c04, poentaro 0.956, latenco 0.719 ms.",
          "cbms_codes": ["CR2", "CR3", "CR4", "CR1"]
        },
        "consequence": "The code-book layer works and is proven end to end - on a sentence template it was built for. It was never extended past that template."
      }
    },
    {
      "id": "F05",
      "claim": "Retrieval does not run on the code book. It runs on 'Korean keys' - fixed 3-character blocks.",
      "status": "CONFIRMED",
      "evidence": {
        "file": "aions_core/server/korean_keys.py",
        "lines": 34,
        "mechanism": "For each alphanumeric token: character 3-grams of the first 12 chars, prefixed 'g:'; plus two 3-char groups of SHA1(token) hex, prefixed 'h:'. Returns a set. Query and chunk are scored by set overlap.",
        "korean_content": "none - the file contains no Korean character",
        "what_korean_means_here": "an analogy to Hangul, where a syllable packs into one fixed-width block; hence fixed-length 3-character keys",
        "retrieval_order": "aions_core/server/cbms_memory.py cbms_think(): injected context first, then Korean keys (cap 25), then symbolic hits (top 7), then concept buckets (cap 8 each), total capped at 40"
      }
    },
    {
      "id": "F06",
      "claim": "Korean characters do appear in CBMS - as chunk addresses, in a different module.",
      "status": "CONFIRMED",
      "evidence": {
        "file": "aions_core/server/hangul_addressing.py",
        "lines": 20,
        "mechanism": "make_hangul_code(data, length=23): SHA1 hex, each hex digit d mapped to chr(ord('\uac00') + d*32)",
        "measured": "52 of 167 live chunks carry a hangul_code field",
        "example": "K015B0B1D5ECD -> \uadc0\uade0\uadc0\uaca0\uace0\uad20\uad00\uad20\uad20\uad00\uad20\uac20\uac00\uaca0\uad00\uade0\uac00\uadc0\uad20\uac80\uac20",
        "consequence": "It is a second name for a chunk, derived from its id. Nothing in retrieval reads it. Purely decorative addressing at present."
      }
    },
