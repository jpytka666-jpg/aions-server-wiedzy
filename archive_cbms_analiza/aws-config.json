{
  "region": "us-east-1",
  "profile": "default",
  "services": {
    "lambda": {
      "runtime": "python3.9",
      "timeout": 30,
      "memory": 128
    },
    "s3": {
      "bucket_prefix": "kiro-project"
    },
    "dynamodb": {
      "billing_mode": "PAY_PER_REQUEST"
    }
  },
  "deployment": {
    "stack_name": "kiro-aws-stack",
    "template_format": "yaml"
  }
}