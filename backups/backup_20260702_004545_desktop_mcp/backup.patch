+                    "session_id": session_id,
+                    "goal": session["goal"],
+                    "status": session["status"],
+                    "current_step": session["current_step"],
+                    "max_steps": session["max_steps"],
+                    "branches": list(session["branches"].keys()),
+                    "active_branch": session["active_branch"],
+                    "created": session["created"]
