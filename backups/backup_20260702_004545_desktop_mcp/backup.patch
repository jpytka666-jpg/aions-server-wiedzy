-def korean_build_keys(text: str) -> set:
-    if not text:
-        return set()
-    tokens = re.findall(r"[A-Za-z0-9]{2,}", text.lower())
-    keys = set()
-    for tok in tokens[:30]:
-        for i in range(len(tok) - 2):
-            keys.add(f"g:{tok[i:i+3]}")
-        h = hashlib.sha1(tok.encode()).hexdigest()[:12]
-        keys.add(f"h:{h[0:3]}")
-    return keys
