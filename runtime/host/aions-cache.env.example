# AIONS cache — dev/test wyłącznie na D: (nie C:, nie E: prod repo)
# Źródło: scripts/set_aions_cache_env.ps1 / set_aions_cache_env.sh

# WSL / Linux dev mirror
AIONS_CACHE_ROOT=/mnt/d/AIONS_DEV/cache
PIP_CACHE_DIR=/mnt/d/AIONS_DEV/cache/pip
TEMP=/mnt/d/AIONS_DEV/cache/temp
TMP=/mnt/d/AIONS_DEV/cache/temp
HF_HOME=/mnt/d/AIONS_DEV/cache/hf
HUGGINGFACE_HUB_CACHE=/mnt/d/AIONS_DEV/cache/hf/hub
TRANSFORMERS_CACHE=/mnt/d/AIONS_DEV/cache/hf/transformers
TORCH_HOME=/mnt/d/AIONS_DEV/cache/torch
XDG_CACHE_HOME=/mnt/d/AIONS_DEV/cache
DOCKER_CONFIG=/mnt/d/AIONS_DEV/cache/docker/config

# Windows (PowerShell) — te same ścieżki, backslash:
# AIONS_CACHE_ROOT=D:\AIONS_DEV\cache
# PIP_CACHE_DIR=D:\AIONS_DEV\cache\pip
# TEMP=D:\AIONS_DEV\cache\temp
# HF_HOME=D:\AIONS_DEV\cache\hf
# TORCH_HOME=D:\AIONS_DEV\cache\torch

# Host-linux prod install (Oracle) — cache pod state root, nie na /tmp:
# AIONS_CACHE_ROOT=/var/lib/aions/cache
# PIP_CACHE_DIR=/var/lib/aions/cache/pip
# TEMP=/var/lib/aions/cache/temp
# HF_HOME=/var/lib/aions/cache/hf
# TORCH_HOME=/var/lib/aions/cache/torch
