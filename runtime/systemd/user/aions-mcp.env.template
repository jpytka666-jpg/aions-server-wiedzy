# Installed to ~/aions/config/aions-mcp.env by aions-ctl mcp-install
# AIONS_REPO uses symlink /mnt/e/aions-repo (no spaces for systemd)
AIONS_REPO=/mnt/e/aions-repo
AIONS_DEV_ROOT=/mnt/d/AIONS_DEV
AIONS_DEPLOYMENT_PROFILE=wsl-dev
AIONS_LOG_DIR=//home/aions/aions/logs
AIONS_SEARCH_ROOTS=/mnt/e/aions-repo
AIONS_VECTOR_BACKEND=embedded
AIONS_API_BASE_URL=http://127.0.0.1:8765
DESKTOP_ENABLED=false
CHROMA_PATH=/mnt/d/AIONS_DEV/data/chroma
AIONS_PATH=/mnt/d/AIONS-INTEGRATION/aions_core
PYTHONIOENCODING=utf-8
PYTHONUNBUFFERED=1
PYTHONUTF8=1
ANONYMIZED_TELEMETRY=False
CHROMA_TELEMETRY_ENABLED=false
