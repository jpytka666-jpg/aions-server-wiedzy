# Manual WSL/dev profile for localhost-only aions-api.service.
# Copy to ~/aions/config/aions-runtime.env for manual install/start.
AIONS_REPO=/mnt/e/aions-repo
AIONS_DEV_ROOT=/mnt/d/AIONS_DEV
AIONS_DEPLOYMENT_PROFILE=wsl-dev
AIONS_LOG_DIR=@HOME@/aions/logs
AIONS_API_PORT=8765
AIONS_API_BASE_URL=http://127.0.0.1:8765
AIONS_SEARCH_ROOTS=/mnt/e/aions-repo
AIONS_SEARCH_PROVIDER=aions-linux-index
AIONS_SEARCH_INDEX_PATH=@HOME@/aions/state/search/aions_search_index.json
AIONS_SEARCH_AUTO_REFRESH_SECONDS=900
AIONS_VECTOR_BACKEND=embedded
CHROMA_USE_HTTP=false
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_PATH=/mnt/d/AIONS_DEV/data/chroma
AIONS_PATH=/mnt/d/AIONS-INTEGRATION/aions_core
DESKTOP_ENABLED=false
PYTHONIOENCODING=utf-8
PYTHONUNBUFFERED=1
PYTHONUTF8=1
ANONYMIZED_TELEMETRY=False
CHROMA_TELEMETRY_ENABLED=false
