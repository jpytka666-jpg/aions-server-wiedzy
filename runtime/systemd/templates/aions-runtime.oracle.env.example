# Oracle/Linux always-on profile
# Sample only. Do not copy over active WSL dev env without review.

AIONS_DEPLOYMENT_PROFILE=oracle-linux
AIONS_REPO=/home/aions/aions-repo
AIONS_LOG_DIR=/home/aions/aions/logs
AIONS_SEARCH_ROOTS=/home/aions/aions-repo
AIONS_SEARCH_PROVIDER=aions-linux-index
AIONS_SEARCH_INDEX_PATH=/home/aions/aions/state/search/aions_search_index.json
AIONS_SEARCH_AUTO_REFRESH_SECONDS=900

# Control plane
AIONS_API_PORT=8765
AIONS_API_BASE_URL=http://127.0.0.1:8765
AIONS_VECTOR_BACKEND=api
CHROMA_USE_HTTP=false
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000

# Canonical Linux data paths
CHROMA_PATH=/home/aions/aions/data/chroma
AIONS_PATH=/home/aions/aions/data/cbms

# Linux runtime guardrails
DESKTOP_ENABLED=false
AIONS_SCAN_PATH=/home/aions/aions-repo
