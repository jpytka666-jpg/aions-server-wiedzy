[Unit]
Description=AIONS control plane API (template)
After=network.target
# Optional when Chroma runs as a separate HTTP service:
# Wants=aions-chroma.service
# After=aions-chroma.service

[Service]
Type=simple
WorkingDirectory=/mnt/e/aions-repo
EnvironmentFile=%h/aions/config/aions-runtime.env
ExecStart=/usr/bin/env bash -lc '"${AIONS_REPO}/runtime/scripts/start_aions_api.sh"'
Restart=on-failure
RestartSec=10
StandardOutput=append:%h/aions/logs/api.log
StandardError=append:%h/aions/logs/api.log

[Install]
WantedBy=default.target
