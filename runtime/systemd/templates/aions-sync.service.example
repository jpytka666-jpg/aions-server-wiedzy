[Unit]
Description=AIONS dev mirror sync job (template)
After=default.target

[Service]
Type=oneshot
WorkingDirectory=/mnt/e/aions-repo
EnvironmentFile=%h/aions/config/aions-runtime.env
ExecStart=/usr/bin/env bash -lc '"${AIONS_REPO}/scripts/sync_dev_mirror.sh"'
StandardOutput=append:%h/aions/logs/sync.log
StandardError=append:%h/aions/logs/sync.log
