AIONS_REPO=/mnt/e/aions-repo
AIONS_DEPLOYMENT_PROFILE=wsl-dev
# Set to a real absolute path for the target user, e.g. /home/aions/aions/logs
AIONS_LOG_DIR=/home/aions/aions/logs
AIONS_SEARCH_ROOTS=/mnt/e/aions-repo
AIONS_SEARCH_PROVIDER=aions-linux-index
AIONS_SEARCH_INDEX_PATH=/home/aions/aions/state/search/aions_search_index.json
AIONS_SEARCH_AUTO_REFRESH_SECONDS=900

# API control plane
AIONS_API_PORT=8765
AIONS_API_BASE_URL=http://127.0.0.1:8765
AIONS_VECTOR_BACKEND=embedded
CHROMA_USE_HTTP=false
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_PATH=/mnt/d/AIONS_DEV/data/chroma
AIONS_PATH=/mnt/d/AIONS-INTEGRATION/aions_core
DESKTOP_ENABLED=false

# Scanner / index jobs
AIONS_SCAN_PATH=/mnt/e/aions-repo
AIONS_INDEX_DRIVES=D,E

# Optional sync job
AIONS_SYNC_SOURCE=/mnt/e/server wiedzy
AIONS_SYNC_DEST=/mnt/d/AIONS_DEV/repo/server-wiedzy
