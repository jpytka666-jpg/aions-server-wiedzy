# AIONS Python — Single Source of Truth
# Czytany przez scripts/aions_python.ps1 (Windows) i scripts/aions_python.sh (WSL/Linux)
# NIGDY nie wołaj bare `python` — zawsze przez start_aions_* lub aions_python.*

AIONS_PYTHON_VERSION=3.11
AIONS_VENV_WIN=E:\server wiedzy\venv
AIONS_VENV_LINUX=/mnt/d/AIONS_DEV/venv
AIONS_REPO_WIN=E:\server wiedzy
AIONS_REPO_LINUX=/mnt/d/AIONS_DEV/repo/server-wiedzy
